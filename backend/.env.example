# ====================================================
# FTS Store — Backend Environment Variables Configuration
# ====================================================

# Application Info
PROJECT_NAME="FTS Store API"
ENVIRONMENT="development"
DEBUG=True

# Network Binding
HOST="127.0.0.1"
PORT=8000
API_V1_STR="/api/v1"

# Database Configuration
# Local SQLite fallback (safe, zero-setup development default):
DATABASE_URL="sqlite:///./fts_store.db"
# PostgreSQL Production connection string example:
# DATABASE_URL="postgresql://fts_user:fts_password@localhost:5432/fts_store"

# CORS Allowed Origins (comma-separated)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173"
