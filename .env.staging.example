# ==============================================================================
# FTS Store — Staging / Pre-Production Configuration (.env.staging)
# ==============================================================================

ENVIRONMENT=staging
DEBUG=false
PROJECT_NAME="FTS Store [Staging]"
PROJECT_VERSION="1.0.0-rc"

HOST=0.0.0.0
PORT=8000
FORWARDED_ALLOW_IPS="*"
ALLOWED_HOSTS="staging-api.ftsstore.com,staging.ftsstore.com"

SECRET_KEY="REPLACE_WITH_STAGING_SECRET_KEY"
ADMIN_API_KEY="REPLACE_WITH_STAGING_ADMIN_KEY"
ACCESS_TOKEN_EXPIRE_MINUTES=120
SECURE_COOKIES=true

AUTO_BOOTSTRAP_ADMIN=true
INITIAL_ADMIN_EMAIL="admin-staging@frndstech.com"
INITIAL_ADMIN_PASSWORD="REPLACE_WITH_STAGING_ADMIN_PASSWORD"

DATABASE_URL="postgresql://fts_staging:REPLACE_WITH_PASSWORD@postgres-staging.internal:5432/fts_store_staging?sslmode=require"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=15
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_SSL_MODE="require"

BACKEND_CORS_ORIGINS="https://staging.ftsstore.com,https://staging-admin.ftsstore.com"

LOG_LEVEL="DEBUG"
LOG_FORMAT="json"
DOCS_ENABLED=true

MEDIA_STORAGE_BACKEND="local"
PAYMENT_GATEWAY_MODE="simulation"
