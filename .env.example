# ==========================================
# E-Commerce Application Environment Variables
# ==========================================

# Server Configuration
APP_NAME="NovaMart Multi-Category Marketplace"
APP_ENV="development"
DEBUG=True
HOST="127.0.0.1"
PORT=8000

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000"

# Currency & Locale
STORE_CURRENCY="USD"
STORE_CURRENCY_SYMBOL="$"
DEFAULT_TAX_RATE=0.08
FREE_SHIPPING_THRESHOLD=100.00
STANDARD_SHIPPING_FEE=9.99

# API Security (for future auth token signing)
SECRET_KEY="supersecret_novamart_jwt_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
