# ==============================================================================
# FTS Store — Testing Environment Configuration (.env.test)
# ==============================================================================

ENVIRONMENT=testing
DEBUG=true
PROJECT_NAME="FTS Store [Test Suite]"
PROJECT_VERSION="1.0.0-test"

HOST=127.0.0.1
PORT=8000
FORWARDED_ALLOW_IPS="*"
ALLOWED_HOSTS="*"

SECRET_KEY="test_suite_isolated_jwt_secret_key"
ADMIN_API_KEY="fts_admin_secret_key_2026"
ACCESS_TOKEN_EXPIRE_MINUTES=30
SECURE_COOKIES=false

DATABASE_URL="sqlite:///:memory:"
BACKEND_CORS_ORIGINS="*"

LOG_LEVEL="WARNING"
LOG_FORMAT="text"
DOCS_ENABLED=true

PAYMENT_GATEWAY_MODE="simulation"
